{
  "name": "wormhole",
  "version": "1.1.0",
  "description": "P2P file transfer tool using ZEN.",
  "type": "module",
  "main": "src/index.js",
  "bin": {
    "wh": "src/index.js"
  },
  "scripts": {
    "cli": "node src/index.js",
    "build": "cd web && yarn install && yarn build && cd .. && node -e \"const fs=require('fs'); fs.rmSync('dist', {recursive:true, force:true}); fs.cpSync('web/dist', 'dist', {recursive:true});\"",
    "dev": "cd web && yarn dev",
    "start": "npx serve dist",
    "test": "echo \"Error: no test specified\" && exit 1",
    "lint": "eslint .",
    "format": "prettier --write ."
  },
  "keywords": [
    "zen",
    "p2p",
    "file-transfer",
    "cli",
    "wormhole"
  ],
  "author": "scobru",
  "license": "MIT",
  "dependencies": {
    "chalk": "^5.3.0",
    "clipboardy": "^4.0.0",
    "dotenv": "^17.2.3",
    "filesize": "^10.1.0",
    "node-datachannel": "^0.33.4",
    "ora": "^8.0.1",
    "vercel": "^50.22.1",
    "zen": "https://github.com/scobru/zen"
  },
  "devDependencies": {
    "eslint": "^8.57.0",
    "prettier": "^3.2.5",
    "serve": "^14.2.1"
  }
}
